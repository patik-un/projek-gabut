{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Event Booth Studio",
  "version": "0.1.10",
  "identifier": "com.autophoto.eventbooth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run check:release && npm run build && npm run prepare:backend && npm run build:backend && npm run prepare:camera-bridges",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Event Booth Studio",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8000 http://localhost:8000 ws://localhost:1421; img-src 'self' asset: data: blob: http://127.0.0.1:8000 https://lh3.googleusercontent.com; media-src 'self' blob: http://127.0.0.1:8000; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "resources": {
      "backend-bin/": "backend-bin",
      "backend-seed/": "backend-seed",
      "camera-bridges/": "camera-bridges"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.1"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyREMwNkIxMTYzNTU5NTQKUldSVVdUVVdzUWJjTXJraCtueGpWc1J1ck9lZTJab0cxQWpQUTNscmZxV09MNTN6SFZYME1FNi8K",
      "endpoints": [
        "https://github.com/patik-un/projek-gabut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
